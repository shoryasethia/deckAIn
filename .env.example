# GOOGLE GEMINI API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# GROQ API (for Visual Feedback Loop)
GROQ_API_KEY=your_groq_api_key_here
# Check https://console.groq.com/docs/models for latest vision models 
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# UNSPLASH API (for license-safe images)
# Get free key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# WEB SEARCH (DuckDuckGo - no key needed)
ENABLE_WEB_SEARCH=true

# OUTPUT CONFIGURATION
OUTPUT_DIR=output
ENABLE_CITATIONS=true
ENABLE_COMPLIANCE_CHECKS=true
USE_LLM_FOR_SLIDES=false

# PERFORMANCE
MAX_RETRIES=3
API_TIMEOUT=120
LOG_LEVEL=INFO

# SECURITY
SANDBOX_TIMEOUT=30
ALLOWED_IMPORTS=pandas,numpy,re,json,datetime

# GROQ CONFIG
ENABLE_GROQ_REVIEW=false